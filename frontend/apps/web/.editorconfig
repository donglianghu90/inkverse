# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# 通用规则
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown 文件保留尾部空格
[*.md]
trim_trailing_whitespace = false

# JSON 文件
[*.json]
indent_size = 2

# YAML 文件
[*.{yml,yaml}]
indent_size = 2

# Makefile 使用 tab
[Makefile]
indent_style = tab

# Shell 脚本
[*.sh]
indent_size = 2
