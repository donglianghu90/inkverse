{
  "name": "inkverse",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "cross-env NODE_ENV=development nest start",
    "start:local": "cross-env NODE_ENV=development CONFIG_ENV=local nest start --watch",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:test": "cross-env NODE_ENV=test nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/apps/config-test/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/config-test/test/jest-e2e.json",
    "init:admin": "ts-node -r tsconfig-paths/register scripts/init-admin.ts",
    "add-scheme-fields": "ts-node -r tsconfig-paths/register scripts/add-scheme-fields.ts"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.17.1",
    "@hokify/agenda": "^6.3.0",
    "@langchain/anthropic": "^1.3.20",
    "@langchain/core": "^1.1.27",
    "@langchain/google-genai": "^2.1.20",
    "@liaoliaots/nestjs-redis": "^10.0.0",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/swagger": "^11.1.3",
    "@nestjs/typeorm": "^10.0.0",
    "@nestx-log4js/core": "^1.5.1",
    "ali-oss": "^6.20.0",
    "axios": "^1.8.3",
    "bcrypt": "^6.0.0",
    "bottleneck": "^2.19.5",
    "bullmq": "^5.41.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "kafkajs": "^2.2.4",
    "log4js": "^6.9.1",
    "nestjs-i18n": "^10.5.1",
    "pg": "^8.13.1",
    "pgvector": "^0.2.1",
    "properties-parser": "^0.6.0",
    "reflect-metadata": "^0.2.0",
    "request-ip": "^3.3.0",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "xml2js": "^0.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.12",
    "@tsconfig/recommended": "^1.0.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.3.1",
    "@types/properties-parser": "^0.3.3",
    "@types/request-ip": "^0.0.41",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^10.0.0",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "concurrently": "^8.2.2",
    "copy-webpack-plugin": "^12.0.2",
    "cpx": "^1.5.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "moduleNameMapper": {
      "^@packages/common$": "<rootDir>/packages/common/src",
      "^@packages/common/(.*)$": "<rootDir>/packages/common/src/$1",
      "^@packages/utils$": "<rootDir>/packages/utils/src",
      "^@packages/utils/(.*)$": "<rootDir>/packages/utils/src/$1",
      "^@packages/modules$": "<rootDir>/packages/modules",
      "^@packages/modules/(.*)$": "<rootDir>/packages/modules/src/$1"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "testEnvironment": "node"
  }
}
