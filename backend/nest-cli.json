{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true
  },
  "generateOptions": {
    "spec": false
  },
  "monorepo": true,
  "root": "apps/public-api",
  "sourceRoot": "apps/public-api/src",
  "projects": {
    "public-api": {
      "type": "application",
      "root": "apps/public-api",
      "entryFile": "main",
      "sourceRoot": "apps/public-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/public-api/tsconfig.app.json"
      }
    },
    "admin-api": {
      "type": "application",
      "root": "apps/admin-api",
      "entryFile": "main",
      "sourceRoot": "apps/admin-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/admin-api/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "packages/common",
      "entryFile": "index",
      "sourceRoot": "packages/common/src",
      "compilerOptions": {
        "tsConfigPath": "packages/common/tsconfig.lib.json"
      }
    },
    "modules": {
      "type": "library",
      "root": "packages/modules",
      "entryFile": "index",
      "sourceRoot": "packages/modules",
      "compilerOptions": {
        "tsConfigPath": "packages/modules/tsconfig.lib.json"
      }
    },
    "utils": {
      "type": "library",
      "root": "packages/utils",
      "entryFile": "index",
      "sourceRoot": "packages/utils/src",
      "compilerOptions": {
        "tsConfigPath": "packages/utils/tsconfig.lib.json"
      }
    }
  }
}